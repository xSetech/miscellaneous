+/* Objects handed to a lessee are no longer ours to program.  Which ones those
+ * are is not something the kernel will tell us back, so the ids go in a set as
+ * the lease is created and come out when it ends. */
+static void
+track_leased_objects (MetaKmsImplDevice *impl_device,
+                      uint32_t          *object_ids,
+                      int                n_object_ids,
+                      uint32_t           lessee_id)
+{
+  MetaKmsImplDevicePrivate *priv =
+    meta_kms_impl_device_get_instance_private (impl_device);
+  int i;
+
+  if (!priv->leased_objects)
+    priv->leased_objects = g_hash_table_new (NULL, NULL);
+
+  for (i = 0; i < n_object_ids; i++)
+    {
+      g_hash_table_insert (priv->leased_objects,
+                          GUINT_TO_POINTER (object_ids[i]),
+                          GUINT_TO_POINTER (lessee_id));
+    }
+}
+
+static void
+untrack_leased_objects (MetaKmsImplDevice *impl_device,
+                        uint32_t           lessee_id)
+{
+  MetaKmsImplDevicePrivate *priv =
+    meta_kms_impl_device_get_instance_private (impl_device);
+  GHashTableIter iter;
+  gpointer value;
+
+  if (!priv->leased_objects)
+    return;
+
+  g_hash_table_iter_init (&iter, priv->leased_objects);
+  while (g_hash_table_iter_next (&iter, NULL, &value))
+    {
+      if (GPOINTER_TO_UINT (value) == lessee_id)
+        g_hash_table_iter_remove (&iter);
+    }
+}
+
+gboolean
+meta_kms_impl_device_is_object_leased (MetaKmsImplDevice *impl_device,
+                                       uint32_t           object_id)
+{
+  MetaKmsImplDevicePrivate *priv =
+    meta_kms_impl_device_get_instance_private (impl_device);
+
+  return priv->leased_objects &&
+         g_hash_table_contains (priv->leased_objects,
+                                GUINT_TO_POINTER (object_id));
+}
+
 gboolean
 meta_kms_impl_device_lease_objects (MetaKmsImplDevice  *impl_device,
                                     GList              *connectors,
