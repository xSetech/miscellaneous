+        // Near negative integers lgamma has poles; both glibc and SLEEF lose
+        // accuracy there and can disagree by orders of magnitude.  Skip values
+        // within 0.1 of any non-positive integer to keep the test deterministic.
+        auto filter_lgamma = [](UVT& val) {
+            UVT rounded = std::round(val);
+            if (rounded <= UVT(0) && std::abs(val - rounded) < UVT(0.1)) {
+                val = rounded - UVT(0.5);
+            }
+        };
         test_unary<vec>(
             NAME_INFO(lgamma),
             RESOLVE_OVERLOAD(std::lgamma),
             [](vec v) { return v.lgamma(); },
-            testCase);
+            testCase,
+            filter_lgamma);
     }
