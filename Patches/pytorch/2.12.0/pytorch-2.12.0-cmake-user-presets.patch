+class TestCMakeUserPresets(unittest.TestCase):
+    def _write_preset(self, tmpdir: str, data: dict[str, object]) -> None:
+        with open(os.path.join(tmpdir, "CMakeUserPresets.json"), "w") as f:
+            json.dump(data, f)
+
+    def test_no_file_returns_empty(self) -> None:
+        with tempfile.TemporaryDirectory() as tmpdir:
+            cache, env = _load_cmake_user_preset(tmpdir)
+            self.assertEqual(cache, {})
+            self.assertEqual(env, {})
+
+    def test_loads_cache_and_env_vars(self) -> None:
+        with tempfile.TemporaryDirectory() as tmpdir:
+            self._write_preset(tmpdir, {
+                "version": 6,
+                "configurePresets": [{
+                    "name": "default",
+                    "cacheVariables": {
+                        "USE_ROCM": "ON",
+                        "USE_CUDA": "OFF",
+                    },
+                    "environment": {
+                        "ROCM_PATH": "/opt/rocm-6.4",
+                        "PYTORCH_ROCM_ARCH": "gfx942",
+                    },
+                }],
+            })
+            cache, env = _load_cmake_user_preset(tmpdir)
+            self.assertEqual(cache, {"USE_ROCM": "ON", "USE_CUDA": "OFF"})
+            self.assertEqual(
+                env, {"ROCM_PATH": "/opt/rocm-6.4", "PYTORCH_ROCM_ARCH": "gfx942"}
+            )
+
+    def test_named_preset(self) -> None:
+        with tempfile.TemporaryDirectory() as tmpdir:
+            self._write_preset(tmpdir, {
+                "version": 6,
+                "configurePresets": [
+                    {"name": "default", "cacheVariables": {"USE_CUDA": "ON"}},
+                    {"name": "rocm", "cacheVariables": {"USE_ROCM": "ON"}},
+                ],
+            })
+            cache, env = _load_cmake_user_preset(tmpdir, preset_name="rocm")
+            self.assertEqual(cache, {"USE_ROCM": "ON"})
+            self.assertEqual(env, {})
+
+    def test_missing_preset_warns_and_returns_empty(self) -> None:
+        with tempfile.TemporaryDirectory() as tmpdir:
+            self._write_preset(tmpdir, {
+                "version": 6,
+                "configurePresets": [
+                    {"name": "cuda", "cacheVariables": {"USE_CUDA": "ON"}},
+                ],
+            })
+            cache, env = _load_cmake_user_preset(tmpdir, preset_name="nonexistent")
+            self.assertEqual(cache, {})
+            self.assertEqual(env, {})
+
+    def test_typed_cache_variable(self) -> None:
+        """CMake presets allow {"type": "BOOL", "value": "ON"} form."""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            self._write_preset(tmpdir, {
+                "version": 6,
+                "configurePresets": [{
+                    "name": "default",
+                    "cacheVariables": {
+                        "USE_ROCM": {"type": "BOOL", "value": "ON"},
+                    },
+                }],
+            })
+            cache, env = _load_cmake_user_preset(tmpdir)
+            self.assertEqual(cache, {"USE_ROCM": "ON"})
+
+    def test_null_env_var_is_skipped(self) -> None:
+        """CMake presets use null to unset an env var; we skip those."""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            self._write_preset(tmpdir, {
+                "version": 6,
+                "configurePresets": [{
+                    "name": "default",
+                    "environment": {"UNSET_ME": None, "KEEP": "val"},
+                }],
+            })
+            cache, env = _load_cmake_user_preset(tmpdir)
+            self.assertEqual(env, {"KEEP": "val"})
+
+    def test_cmake_user_preset_env_override(self) -> None:
+        """CMAKE_USER_PRESET env var selects which preset to use."""
+        with tempfile.TemporaryDirectory() as tmpdir:
+            self._write_preset(tmpdir, {
+                "version": 6,
+                "configurePresets": [
+                    {"name": "default", "cacheVariables": {"A": "1"}},
+                    {"name": "custom", "cacheVariables": {"B": "2"}},
+                ],
+            })
+            with env_var("CMAKE_USER_PRESET", "custom"):
+                cache, _ = _load_cmake_user_preset(tmpdir)
+            self.assertEqual(cache, {"B": "2"})
+
