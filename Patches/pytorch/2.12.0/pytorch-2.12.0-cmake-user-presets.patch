+def _load_cmake_user_preset(
+    base_dir: str, preset_name: str | None = None
+) -> tuple[dict[str, str], dict[str, str]]:
+    """Load cache and environment variables from CMakeUserPresets.json.
+
+    Returns (cache_vars, env_vars). Both dicts map variable names to string values.
+    Returns empty dicts if the file does not exist or the preset is not found.
+    """
+    preset_file = os.path.join(base_dir, "CMakeUserPresets.json")
+    if not os.path.isfile(preset_file):
+        return {}, {}
+
+    with open(preset_file) as f:
+        data = json.load(f)
+
+    preset_name = preset_name or os.environ.get("CMAKE_USER_PRESET", "default")
+    presets = data.get("configurePresets", [])
+
+    preset = None
+    for p in presets:
+        if p.get("name") == preset_name:
+            preset = p
+            break
+
+    if preset is None:
+        available = [p.get("name") for p in presets]
+        eprint(
+            f"WARNING: CMakeUserPresets.json does not contain a preset named "
+            f"'{preset_name}'. Available presets: {available}"
+        )
+        return {}, {}
+
+    cache_vars: dict[str, str] = {}
+    for k, v in preset.get("cacheVariables", {}).items():
+        if isinstance(v, dict):
+            # Handle {"type": "BOOL", "value": "ON"} form
+            cache_vars[k] = str(v.get("value", ""))
+        else:
+            cache_vars[k] = str(v)
+
+    env_vars: dict[str, str] = {}
+    for k, v in preset.get("environment", {}).items():
+        if v is not None:
+            env_vars[k] = str(v)
+
+    return cache_vars, env_vars
+
